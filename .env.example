# Copy to .env and add your key:  cp .env.example .env
# Free Groq key, no card needed: https://console.groq.com/keys
GROQ_API_KEY=your-free-key-from-console.groq.com

# Optional. Any OpenAI-compatible gateway works (Groq, OpenRouter, vLLM, Ollama, ...)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=                        # used instead of GROQ_API_KEY when set
# TARGET_MODEL=openai/gpt-oss-20b     # the frozen model that reads the skill
# OPTIMIZER_MODEL=openai/gpt-oss-120b # the model that rewrites the skill (training only)
# REASONING_EFFORT=low                # set empty for non-reasoning models
